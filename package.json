{
  "name": "barebastian",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=5173 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-server/server.cjs --log-level=warning",
    "release": "node scripts/build-release.mjs",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning dist-server/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "release:php": "node scripts/build-php.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",

# ─────────────────────────────────────────────────────────────
#  BAREBASTIAN – Server-Einstellungen
#  Kopie als ".env" speichern und anpassen. Datei NIE öffentlich machen.
#  Werte mit Leer- oder Sonderzeichen in 'einfache Anführungszeichen' setzen.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Öffentliche Adresse (für Links in E-Mails)
BASE_URL=https://bare-bastian.de
SITE_NAME=BAREBASTIAN

# Speicherorte
DATA_DIR=/opt/barebastian/data
PUBLIC_DIR=/opt/barebastian/app/public

# Admin-Konto – wird beim ERSTEN Start angelegt.
# Danach ADMIN_PASSWORD wieder löschen (das Setup-Skript macht das automatisch).
ADMIN_EMAIL=admin@bare-bastian.de
ADMIN_PASSWORD=

# E-Mail-Versand (z. B. Hostinger-Postfach: smtp.hostinger.com, Port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@bare-bastian.de
SMTP_PASS=
MAIL_FROM=noreply@bare-bastian.de
# Hierhin gehen Benachrichtigungen (Kontaktformular, Abo-Anfragen, neue Mitglieder)
NOTIFY_EMAIL=contact@bare-bastian.de

# Zahlung: Text, den Mitglieder nach einer Abo-Anfrage sehen (auch per E-Mail)
PAYMENT_INFO='Danke für deine Anfrage! Du erhältst in Kürze die Zahlungsinformationen per E-Mail. Sobald die Zahlung eingegangen ist, schalte ich dein Abo frei.'
# Optional: Bezahl-Links je Paket (z. B. von deinem Zahlungsanbieter)
PAYMENT_LINK_MONTHLY=
PAYMENT_LINK_QUARTERLY=
PAYMENT_LINK_YEARLY=

# Upload-Grenzen in MB
MAX_VIDEO_UPLOAD_MB=2048
MAX_IMAGE_UPLOAD_MB=15
